# Bling ERP v3 OAuth 2.0 credentials.
# Create an app at https://www.bling.com.br/cadastro.api.php to obtain these.
BLING_CLIENT_ID=your_client_id
BLING_CLIENT_SECRET=your_client_secret

# Obtained once via the authorization-code flow; the server auto-refreshes the
# short-lived access token using this refresh token.
BLING_REFRESH_TOKEN=your_refresh_token

# Optional overrides (sensible defaults applied when omitted).
# BLING_API_BASE_URL=https://api.bling.com.br/Api/v3
# BLING_ACCOUNT_LABEL=default

# Optional: where the rotated refresh token is cached.
# Default: %LOCALAPPDATA%\bling-mcp\token.json (Windows),
#          ~/Library/Application Support/bling-mcp/token.json (macOS),
#          $XDG_STATE_HOME/bling-mcp/token.json, else ~/.local/state/bling-mcp/token.json (Linux)
# BLING_TOKEN_STORE=

# Optional: loopback port the in-chat re-authorization (bling_authorize) listens
# on for Bling's OAuth redirect. Register http://localhost:<port>/callback as the
# app's "link de redirecionamento" in Bling. Default 8765.
# BLING_OAUTH_CALLBACK_PORT=8765
# Host in that redirect URL (listener always binds 127.0.0.1). Default localhost.
# BLING_OAUTH_REDIRECT_HOST=localhost

# Optional: Bling is retiring opaque tokens (developer.bling.com.br/migracao-jwt).
# Default 1 sends the enable-jwt header so tokens come back as JWT. 0 = opaque.
# BLING_ENABLE_JWT=1

# Optional: restrict the exposed tools to specific domains (comma-separated).
# Omit to expose every module. Valid: produtos, pedidos, contatos, financeiro,
# fiscal, estoque, logistica, producao, situacoes, cadastros.
# BLING_MODULES=produtos,pedidos,estoque
